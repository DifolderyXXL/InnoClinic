{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

 "BFF": {
  "Authority": "https://IdentityServer",
  "ClientId": "interactive.confidential",
  "ClientSecret": "secret",
  "Scopes": [ "openid", "profile", "api", "email", "offline_access", "role" ],

  "Apis": [
    {
      "PathMatch": "/api/profiles",
      "RemoteUrl": "https://ProfilesAPI", 
      "RequiredToken": "User"
    }
  ],
  "Microservices": [
    { "Name": "ProfilesAPI", "Path": "/profiles", "SupportedVersions": ["v1"]},
    { "Name": "OfficesAPI", "Path": "/offices", "SupportedVersions": ["v1"]},
    { "Name": "ServicesAPI", "Path": "/services", "SupportedVersions": ["v1"]},
    { "Name": "AppointmentsAPI", "Path": "/appointments", "SupportedVersions": ["v1"]},
    { "Name": "DocumentsAPI", "Path": "/documents", "SupportedVersions": ["v1"]},
    { "Name": "IdentityServer", "Path": "/identity", "SupportedVersions": ["v1"]}
  ]
 },
  "oauth": {
    "clientid": "swagger-interactive",
    "secret": "secret"
  }
}
