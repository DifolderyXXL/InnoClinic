@page
@model Deunde.IdentityServer.Pages.Account.ConfirmEmailCallback.Index
@{
    ViewData["Title"] = "Verification Email";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            @if (Model.IsSucceeded)
            {
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">Success!</h4>
                    <p>@Model.StatusMessage</p>
                </div>
                <div class="mt-4">
                    <a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-primary">
                        Login
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Error</h4>
                    <p>@Model.StatusMessage</p>
                </div>
            }
        </div>
    </div>
</div>