@page
@model Deunde.IdentityServer.Pages.Account.SetPassword.Index
@{
    ViewData["Title"] = "Set Password";
}

<div class="set-password-page">
    <h2>Create Your Password</h2>
    <p>Please enter a password for your account to complete registration.</p>

    <form method="post">
        <input type="hidden" asp-for="Input.UserId" />
        <input type="hidden" asp-for="Input.Token" />
        <input type="hidden" asp-for="Input.ReturnUrl" />
        
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group mb-3">
            <label asp-for="Input.Password">New Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-primary">Save Password</button>
    </form>
</div>